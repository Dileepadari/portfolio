# Copy to .env.local and fill in. Nothing here is a real value.
#
# Two separate sets of variables, and mixing them up is the mistake to avoid:
#
#   VITE_*  is compiled into the browser bundle. Anything here is public by
#           definition. Never put a secret in one.
#
#   everything else is read by the `admin` Edge Function on the server. In
#           production these are set with `npx supabase secrets set`; for local
#           `supabase functions serve` they go in supabase/functions/.env,
#           which is gitignored.
#
# The function has no fallback for its two secrets and refuses to boot without
# them. That is deliberate: they were once written into the source as `??`
# defaults and shipped to a public repository.

# ---------------------------------------------------------------------------
# Browser. Public by design.
# ---------------------------------------------------------------------------

# Local Supabase (`npx supabase start` prints these).
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="localhost"

# For the hosted project instead:
#   VITE_SUPABASE_URL="https://<ref>.supabase.co"
#   VITE_SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
#   VITE_SUPABASE_PROJECT_ID="<ref>"

# ---------------------------------------------------------------------------
# Edge Function. Secrets. Never VITE_ prefixed, never committed.
# ---------------------------------------------------------------------------

# Signs the admin session JWT this app issues itself.
#   openssl rand -hex 32
ADMIN_JWT_SECRET=

# The self-hosted storage box's own JWT secret, used to mint a short-lived
# upload token. Shared with every other project that uploads to that box, so
# rotating it is not a local decision.
SELFHOST_JWT_SECRET=

# Shared secret the storage box's upload endpoint checks.
ORACLE_UPLOAD_API_KEY=

# Storage box routing. Not secret; here so a fork can point somewhere else.
ORACLE_UPLOAD_BASE_URL="https://supabase.dileepadari.dev"
ORACLE_PUBLIC_BASE_URL="https://mystorage.dileepadari.dev"
ORACLE_UPLOAD_PATH="/upload"
ORACLE_APP_NAME="portfolio"

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
# automatically. Do not set them yourself.
